{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {}
  },
  "rewrites": [
    { "source": "/health",       "destination": "/api/index.js" },
    { "source": "/api/:path*",   "destination": "/api/index.js" },
    { "source": "/openai/:path*","destination": "/api/index.js" },
    { "source": "/gtts/:path*",  "destination": "/api/index.js" },
    { "source": "/app/:path*",   "destination": "/api/index.js" },
    { "source": "/gemini/:path*","destination": "/api/index.js" }
  ]
}
