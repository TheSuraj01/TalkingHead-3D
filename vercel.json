{
  "headers": [
    {
      "source": "/(.*)\\.mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/openai/(.*)", "destination": "/api/index.js" },
    { "source": "/gtts/(.*)", "destination": "/api/index.js" },
    { "source": "/app/(.*)", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
