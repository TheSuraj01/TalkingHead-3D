{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/health",         "dest": "/api/index.js" },
    { "src": "/api/(.*)",       "dest": "/api/index.js" },
    { "src": "/openai/(.*)",    "dest": "/api/index.js" },
    { "src": "/gtts/(.*)",      "dest": "/api/index.js" },
    { "src": "/app/(.*)",       "dest": "/api/index.js" },
    { "src": "/gemini/(.*)",    "dest": "/api/index.js" },
    { "src": "/(.*)",           "dest": "/$1" }
  ]
}
