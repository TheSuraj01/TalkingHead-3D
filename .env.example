# ========================================================
# TalkingHead Server Configuration
# Copy this file to .env and configure your keys:
# cp .env.example .env
# ========================================================

# Server Port (default: 3000)
PORT=3000

# Groq API Key for AI chat & Whisper audio transcriptions
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret for frontend session tokens (change to any secure string)
JWT_SECRET=talkinghead-secret-key-change-me

# Text-To-Speech: 100% Free Microsoft Edge Neural voices are enabled by default.
# No API key or subscription needed!
# (Optional) If you prefer Google Cloud TTS instead, uncomment and add key:
# GOOGLE_TTS_API_KEY=your_google_cloud_tts_key_here

# (Optional) Google Gemini API Key if using Gemini proxy
# GEMINI_API_KEY=your_gemini_api_key_here
